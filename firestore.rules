rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // GLOBAL HELPER FUNCTIONS
    // ============================================================

    function isAppCreator() {
      return request.auth.uid == "NFwQuUKGKDMZgAZeO3NfcUAUCxl1";
    }

    function isAdminOfFamily(familyId) {
      let familyPath = /databases/$(database)/documents/families/$(familyId);
      return exists(familyPath)
        && get(familyPath).data.adminUids.hasAny([request.auth.uid]);
    }

    function isFamilyMember(familyId) {
      let reqPath = /databases/$(database)/documents/families/$(familyId)/accessRequests/$(request.auth.uid);
      // FIXED (Thread 32) — আগে শুধু family-code join-request-approved uid-কে
      // family-member ধরা হতো। Admin-direct-add + Direct-Identify Key-claim দিয়ে
      // ঢোকা সদস্যদের (যাদের কখনো accessRequests doc তৈরি হয় না, শুধু
      // uidMemberIndex write হয়) জন্য একটা নতুন OR-branch যোগ হলো — নতুন কোনো
      // collection/write লাগেনি, uidMemberIndex আগে থেকেই claim-time-এ লেখা হয়।
      let idxPath = /databases/$(database)/documents/families/$(familyId)/uidMemberIndex/$(request.auth.uid);
      return isAdminOfFamily(familyId)
        || isAppCreator()
        || (exists(reqPath) && get(reqPath).data.status == 'approved')
        || exists(idxPath);
    }

    function memberOwnerUids(familyId, memberId) {
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(memberId);
      // আগে ternary-এর এক শাখায় map, আরেক শাখায় null রিটার্ন করত — Firestore
      // rules-linter সেটাকে "Invalid type" warning দিত (harmless, deploy ব্লক
      // করত না)। এখন দুই শাখাতেই list টাইপ রাখা হলো (cosmetic fix, behavior
      // অপরিবর্তিত) — deploy-log পরিষ্কার রাখতে।
      return (exists(memberPath) && ('ownerUids' in get(memberPath).data))
        ? get(memberPath).data.ownerUids
        : [];
    }

    function isOwnerOfMember(familyId, memberId) {
      return memberOwnerUids(familyId, memberId).hasAny([request.auth.uid]);
    }

    function callerMemberIdOf(familyId) {
      let p = /databases/$(database)/documents/families/$(familyId)/uidMemberIndex/$(request.auth.uid);
      return exists(p) ? get(p).data.memberId : null;
    }

    function existsApprovedGrant(familyId, targetMemberId, callerMemberId) {
      let grantPath = /databases/$(database)/documents/families/$(familyId)/accessGrants/$(targetMemberId + '_' + callerMemberId);
      return exists(grantPath)
        && get(grantPath).data.status == 'approved'
        && get(grantPath).data.scope == 'read+write';
    }

    function hasAccess(familyId, targetMemberId, callerMemberId) {
      return isAdminOfFamily(familyId)
        || (targetMemberId == callerMemberId && isOwnerOfMember(familyId, callerMemberId))
        || (isOwnerOfMember(familyId, callerMemberId)
            && existsApprovedGrant(familyId, targetMemberId, callerMemberId));
    }

    // Owner-Controlled Profile Permission (amendment item ২,
    // 1_1_1_1_Health_Assistant_Amendment_Plan_DRAFT.md) — নতুন `profileShares`
    // collection দিয়ে প্রতিটা সদস্য নিজের প্রোফাইলে read/write আলাদাভাবে ঠিক
    // করতে পারবেন, কোনো request/approve workflow ছাড়াই। **পুরনো accessGrants
    // (Take-Access, Thread 13-14 pattern) সম্পূর্ণ অক্ষত/অপরিবর্তিত রইলো** —
    // existsApprovedGrant() আগের মতোই কাজ করে, তাই আগের সব approved grant
    // (structural Parent-Child<18 সহ, ও পুরনো peer-to-peer approved grant)
    // backward-compatible থাকে, কোনো migration/data-touch লাগেনি। নিচের
    // create/update rule branch-গুলোতে শুধু নতুন **pending self-request**
    // তৈরির পথ বন্ধ করা হয়েছে (§accessGrants match-block-এ, নিচে) — যাতে
    // owner-এর অনুমতি ছাড়া কেউ নিজে থেকে access "claim/request" করতে না পারে।
    function hasProfileShareFlag(familyId, targetMemberId, callerMemberId, flag) {
      let sharePath = /databases/$(database)/documents/families/$(familyId)/profileShares/$(targetMemberId + '_' + callerMemberId);
      return exists(sharePath) && (flag in get(sharePath).data) && get(sharePath).data[flag] == true;
    }

    function hasReadAccess(familyId, targetMemberId, callerMemberId) {
      return isAdminOfFamily(familyId)
        || (targetMemberId == callerMemberId && isOwnerOfMember(familyId, callerMemberId))
        || (isOwnerOfMember(familyId, callerMemberId)
            && (existsApprovedGrant(familyId, targetMemberId, callerMemberId)
                || hasProfileShareFlag(familyId, targetMemberId, callerMemberId, 'read')));
    }

    function hasWriteAccess(familyId, targetMemberId, callerMemberId) {
      return isAdminOfFamily(familyId)
        || (targetMemberId == callerMemberId && isOwnerOfMember(familyId, callerMemberId))
        || (isOwnerOfMember(familyId, callerMemberId)
            && (existsApprovedGrant(familyId, targetMemberId, callerMemberId)
                || hasProfileShareFlag(familyId, targetMemberId, callerMemberId, 'write')));
    }

    function hasDeleteAccess(familyId, targetMemberId) {
      return isAdminOfFamily(familyId) || isOwnerOfMember(familyId, targetMemberId);
    }

    // ============================================================
    // GLOBAL COLLECTIONS (family-independent)
    // ============================================================

    match /familyCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      // FIXED (§২.৬) — শুধু family-র admin code তৈরি করতে পারবেন।
      // "নতুন family তৈরির মুহূর্ত" (adminUids তখনো empty) আলাদাভাবে allow করা
      // হয়েছে যাতে chicken-egg সমস্যায় নতুন family তৈরিই আটকে না যায়।
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['familyId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.familyId is string
        && code.matches('^[A-Za-z0-9_-]{6,30}$')
        && (
             !exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
             || get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.adminUids.size() == 0
             || isAdminOfFamily(request.resource.data.familyId)
           );

      allow update: if false;
      allow delete: if request.auth != null
        && (isAppCreator() || isAdminOfFamily(resource.data.familyId));
    }

    match /keyIndex/{key} {
      allow get: if request.auth != null;
      allow list: if false;

      // FIXED (§২.৫) — admin-check যোগ, key-squatting বন্ধ
      allow create: if request.auth != null
        && isAdminOfFamily(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly(['familyId', 'memberId'])
        && key.matches('^[A-Za-z0-9!@#$%&*+_-]{6,64}$');

      allow update: if false;

      // FIXED (§২.৫) — request.resource.data → resource.data
      allow delete: if request.auth != null
        && isAdminOfFamily(resource.data.familyId);
    }

    match /medicineDatabase/{medicineId} {
      allow read: if request.auth != null
        && resource.data.status == 'verified';
      allow write: if false;
    }

    match /conditionDatabase/{conditionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /remedyDatabase/{remedyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /careEscalationDirectory/{entryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Wellness Guide — ব্লগ-স্টাইল স্বাস্থ্যকর জীবনযাপন নির্দেশিকা (owner-request,
    // ২০২৬-০৯-১২)। careEscalationDirectory/remedyDatabase-এর হুবহু একই pattern:
    // global, family-independent, শুধু trusted local Admin-SDK script
    // (scripts/populateWellnessGuides.js) দিয়ে populate/edit — নতুন পোস্ট
    // যোগ/সম্পাদনা করতে script রি-রান করলেই চলবে, কোনো client-write/rules-change
    // লাগবে না।
    // Wellness Guide — ব্লগ-স্টাইল স্বাস্থ্যকর জীবনযাপন নির্দেশিকা।
    // User-Owned Content model-এ upgrade (owner-approved amendment,
    // 1_1_1_1_Health_Assistant_Amendment_Plan_DRAFT.md item ৩): এখন যেকোনো
    // family member লিখতে পারবে (আগে শুধু Admin), শুধু নিজের লেখা edit করতে
    // পারবে (authorId == callerMemberIdOf), delete author বা Admin উভয়েই
    // পারবেন (health-record delete-override pattern reuse, §3.4.4)। পুরনো
    // legacy doc (authorId ছাড়া, backfill-এর আগে) — backfillWellnessGuideAuthor.js
    // script দিয়ে one-time migrate হবে। category enum WELLNESS_CATEGORIES
    // (wellnessGuideData.js)-এর সাথে sync করা হলো — আগের enum stale ছিল
    // (৫টা পুরনো ক্যাটেগরি vs কোডে ব্যবহৃত ১০টা), এই আপডেটের সাথেই ঠিক করা হলো।
    match /wellnessGuides/{guideId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && isFamilyMember(request.resource.data.familyId)
        && request.resource.data.authorId == callerMemberIdOf(request.resource.data.familyId)
        && request.resource.data.keys().hasAll(['familyId', 'authorId', 'category', 'title', 'body'])
        && request.resource.data.category in
             ['general', 'diet-fitness', 'child-care', 'women-health', 'elderly-care',
              'chronic-disease-prevention', 'mental-health', 'skin-beauty',
              'sleep-lifestyle', 'first-aid-emergency'];
      allow update: if request.auth != null
        && resource.data.authorId == callerMemberIdOf(resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if request.auth != null
        && (isAdminOfFamily(resource.data.familyId)
            || resource.data.authorId == callerMemberIdOf(resource.data.familyId));
    }

    match /knowledgeItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /testNameDictionary/{testId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Diet/Food Guidance — Condition/Allergy-tag ভিত্তিক avoid/include food-list
    // (amendment item ১, 1_1_1_1_Health_Assistant_Amendment_Plan_DRAFT.md)।
    // medicineDatabase-এর হুবহু একই pattern: global, family-independent, শুধু
    // trusted local Admin-SDK script (scripts/populateDietGuidanceRules.js)
    // দিয়ে populate — client-write নেই। `status: 'verified'` না হওয়া পর্যন্ত
    // client read-এ আসে না (draft entry app-এ ব্যবহারযোগ্য না, medicineDatabase-এর
    // মতোই verification-gate)।
    match /dietGuidanceRules/{tagId} {
      allow read: if request.auth != null
        && resource.data.status == 'verified';
      allow write: if false;
    }

    // General Chat — কুইক-লিংক ডিরেক্টরি (নতুন, এই থ্রেড)। careEscalationDirectory-
    // এর হুবহু একই pattern: global, family-independent, শুধু trusted local
    // Admin-SDK script (scripts/populateGeneralChatQuickLinks.js) দিয়ে populate/
    // edit হয় — নতুন লিংক যোগ/সম্পাদনা করতে হলে script চালিয়ে redeploy লাগবে না,
    // শুধু script রি-রান করলেই চলবে।
    match /generalChatQuickLinks/{linkId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================================================
    // FAMILY-SCOPED DATA
    // ============================================================

    match /families/{familyId} {

      allow get: if request.auth != null;
      allow list: if request.auth != null && isFamilyMember(familyId);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['familyId', 'familyCodeDisplay', 'createdBy', 'createdAt', 'adminUids'])
        && request.resource.data.adminUids == [];

      allow update: if request.auth != null
        && resource.data.adminUids.size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids', 'firstAdminUid', 'updatedAt'])
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.firstAdminUid == request.auth.uid;

      // ভেরিফাইড-নিরাপদ (§২.৭) — এই rule-ই নিশ্চিত করে adminUids সবসময়
      // verified path দিয়ে বদলায় (ইতিমধ্যে-admin কেউ, বা প্রথম-admin self-claim,
      // উপরের rule দিয়ে)। আলাদা কোনো নতুন check লাগে না।
      allow update: if request.auth != null
        && resource.data.adminUids.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids', 'updatedAt'])
        && (
             (request.resource.data.adminUids.hasAll(resource.data.adminUids)
              && request.resource.data.adminUids.size() > resource.data.adminUids.size())
             ||
             (resource.data.adminUids.hasAll(request.resource.data.adminUids)
              && request.resource.data.adminUids.size() < resource.data.adminUids.size()
              && request.resource.data.adminUids.size() >= 1
              && (!('firstAdminUid' in resource.data)
                  || request.resource.data.adminUids.hasAny([resource.data.firstAdminUid])
                  || request.auth.uid == resource.data.firstAdminUid))
           );

      allow delete: if request.auth != null && isAppCreator();

      match /accessRequests/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isAdminOfFamily(familyId));
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['status', 'requestedAt'])
          && request.resource.data.status == 'pending';
        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'denied']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']);
        allow delete: if false;
      }

      // General Chat — সেশন/মেসেজ (auto-save মডেল, replaces আগের per-message
      // "generalChatNotes" bookmark — সিদ্ধান্ত-পরিবর্তন এই থ্রেডে)। Admin-only,
      // HealthEpisode/EpisodeMessage-এর হুবহু structural pattern reuse। পুরো
      // session delete-ই একমাত্র delete-scope (owner-approved) — individual
      // message আলাদা মোছার rule ইচ্ছাকৃতভাবে নেই।
      match /generalChatSessions/{sessionId} {
        allow read, create, update, delete: if request.auth != null && isAdminOfFamily(familyId);

        match /messages/{messageId} {
          allow read, create: if request.auth != null && isAdminOfFamily(familyId);
          allow update: if false;
          allow delete: if request.auth != null && isAdminOfFamily(familyId);
        }
      }

      // General Chat — Project (Knowledge + Instructions, lightweight, নতুন)।
      // Admin-only, family-scoped। vector-DB/RAG না — শুধু free-text field,
      // client-side length-cap দিয়ে token-বাজেট রক্ষা হয় (rules-level enforce
      // করা হয়নি — soft-limit, hard-enforce করলে UX জটিল হতো, অপ্রয়োজনীয়)।
      match /generalChatProjects/{projectId} {
        allow read, create, update, delete: if request.auth != null && isAdminOfFamily(familyId);
      }

      match /members/{memberId} {
        allow get: if request.auth != null;
        allow list: if request.auth != null && isFamilyMember(familyId);

        allow create: if request.auth != null && isAdminOfFamily(familyId);

        allow update: if request.auth != null
          && (!('role' in request.resource.data.diff(resource.data).affectedKeys())
              || isAdminOfFamily(familyId))
          && (!('guardianMemberIds' in request.resource.data.diff(resource.data).affectedKeys())
              || isAdminOfFamily(familyId))
          && (!('relationshipLabel' in request.resource.data.diff(resource.data).affectedKeys())
              || isAdminOfFamily(familyId))
          && (
            (
              (memberOwnerUids(familyId, memberId).hasAny([request.auth.uid]) || isAdminOfFamily(familyId))
              // FIXED (§২.৩) — Admin এখন শুধু ownerUids REMOVE/SHRINK করতে
              // পারবেন (device-revoke), নতুন uid ADD করতে গেলে key-verified claim
              // flow-ই লাগবে (নিচের branch-২)। আগের ভার্সনে admin বিনা-verification
              // যেকোনো uid যোগ করতে পারতেন — এখন সেই bypass বন্ধ।
              && (
                   request.resource.data.ownerUids.hasOnly(memberOwnerUids(familyId, memberId))
                   || (isAdminOfFamily(familyId)
                       && memberOwnerUids(familyId, memberId).hasAll(request.resource.data.ownerUids))
                 )
              && (
                !isAdminOfFamily(familyId)
                || !('firstAdminUid' in get(/databases/$(database)/documents/families/$(familyId)).data)
                || !memberOwnerUids(familyId, memberId).removeAll(request.resource.data.ownerUids)
                     .hasAny([get(/databases/$(database)/documents/families/$(familyId)).data.firstAdminUid])
                || request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.firstAdminUid
              )
            )
            ||
            (
              request.resource.data.ownerUids.hasAny([request.auth.uid])
              && (
                   memberOwnerUids(familyId, memberId).hasAny([request.auth.uid])
                   || memberOwnerUids(familyId, memberId).size() < 3
                   || (
                        (!('role' in resource.data) || resource.data.role != "admin")
                        && resource.data.ownerUids.size() == 3
                        && request.resource.data.ownerUids.size() == 3
                        && resource.data.ownerUids.removeAll(request.resource.data.ownerUids).size() == 1
                      )
                   || (
                        'role' in resource.data && resource.data.role == "admin"
                        && resource.data.ownerUids.size() == 3
                        && request.resource.data.ownerUids.size() == 3
                        && resource.data.ownerUids.removeAll(request.resource.data.ownerUids).size() == 1
                        && (
                             !('firstAdminUid' in get(/databases/$(database)/documents/families/$(familyId)).data)
                             || !resource.data.ownerUids.removeAll(request.resource.data.ownerUids)
                                  .hasAny([get(/databases/$(database)/documents/families/$(familyId)).data.firstAdminUid])
                           )
                      )
                 )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUids', 'ownerActivity', 'updatedAt', 'claimKeyHashAttempt'])
              && 'claimKeyHashAttempt' in request.resource.data
              && request.resource.data.claimKeyHashAttempt ==
                 get(/databases/$(database)/documents/families/$(familyId)/members/$(memberId)/private/key).data.keyHash
            )
          );

        // নতুন (§২.২) — claim সফল হওয়ার পরপরই client এই ছোট cleanup-write
        // পাঠাবে যাতে claimKeyHashAttempt member doc-এ স্থায়ী না থাকে (open-roster
        // সবাই পড়তে পারে বলে এই hash সবসময় visible থাকা অনিরাপদ)। মূল claim/FIFO
        // logic (উপরে) সম্পূর্ণ অপরিবর্তিত।
        allow update: if request.auth != null
          && isOwnerOfMember(familyId, memberId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimKeyHashAttempt'])
          && !('claimKeyHashAttempt' in request.resource.data);

        allow delete: if request.auth != null && isAdminOfFamily(familyId);

        match /private/{docId} {
          // FIXED (§২.১) — memberOwnerUids() helper দিয়ে ঠিক করা
          allow get: if request.auth != null
            && (memberOwnerUids(familyId, memberId).hasAny([request.auth.uid])
                || isAdminOfFamily(familyId));
          allow list: if false;
          allow create: if request.auth != null
            && isAdminOfFamily(familyId)
            && docId == 'key'
            && request.resource.data.keys().hasOnly(['key', 'keyHash', 'createdBy', 'createdAt'])
            && request.resource.data.key is string
            && request.resource.data.key.size() >= 6 && request.resource.data.key.size() <= 64
            && request.resource.data.key.matches('^[A-Za-z0-9!@#$%&*+_-]+$')
            && request.resource.data.keyHash is string
            && request.resource.data.keyHash.size() == 64;

          // FIXED (§২.১) — key change (owner/admin উভয়ে) সম্ভব করা হয়েছে
          allow update: if request.auth != null
            && (isAdminOfFamily(familyId)
                || memberOwnerUids(familyId, memberId).hasAny([request.auth.uid]))
            && docId == 'key'
            && request.resource.data.keys().hasOnly(['key', 'keyHash', 'createdBy', 'createdAt'])
            && request.resource.data.key is string
            && request.resource.data.key.size() >= 6 && request.resource.data.key.size() <= 64
            && request.resource.data.key.matches('^[A-Za-z0-9!@#$%&*+_-]+$')
            && request.resource.data.keyHash is string
            && request.resource.data.keyHash.size() == 64;

          allow delete: if false;
        }
      }

      match /uidMemberIndex/{uid} {
        allow get: if request.auth != null
          && (request.auth.uid == uid || isAdminOfFamily(familyId));
        allow list: if false;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['memberId']);
        allow delete: if false;
      }

      match /memberRequests/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isAdminOfFamily(familyId));
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'gender', 'dob', 'status', 'requestedAt', 'presetKey'])
          && request.resource.data.status == 'pending'
          && request.resource.data.presetKey.size() >= 6 && request.resource.data.presetKey.size() <= 64;
        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'denied']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']);
        allow delete: if false;
      }

      match /accessGrants/{grantId} {
        // Owner-Controlled Permission amendment (item ২) — নতুন peer-to-peer
        // "pending self-request" create/approve/deny/re-request branch-গুলো
        // ইচ্ছাকৃতভাবে সরানো হলো (নিচে দ্রষ্টব্য) — এখন থেকে non-structural
        // access শুধু owner নিজে `profileShares`-এ সেট করবেন, কেউ নিজে থেকে
        // request পাঠাতে পারবেন না। **পুরনো approved peer-grant (যদি থাকে)
        // অক্ষত থাকে ও কাজ করে চলে** (existsApprovedGrant() অপরিবর্তিত) —
        // শুধু কোনো নতুন pending-request তৈরি সম্ভব না। Structural
        // Parent-Child(<18) grant create/cancel/re-approve/revocable-flip
        // (Admin-driven) সম্পূর্ণ অপরিবর্তিত।
        allow read: if request.auth != null && isFamilyMember(familyId);

        allow create: if request.auth != null
          && isAdminOfFamily(familyId)
          && request.resource.data.keys().hasOnly(
               ['granterId', 'granteeId', 'scope', 'relationshipType', 'status', 'revocable', 'grantedAt', 'createdAt'])
          && request.resource.data.scope == 'read+write'
          && request.resource.data.status == 'approved'
          && request.resource.data.relationshipType == 'parent-child'
          && request.resource.data.revocable == false;

        // পুরনো approved peer-grant (revocable:true) — owner বা grantee
        // যেকোনো পক্ষ থেকে cancel করা যাবে, যাতে পুরনো data-owner চাইলে
        // legacy access সরিয়ে নতুন profileShares-এ migrate করতে পারেন।
        allow update: if request.auth != null
          && isFamilyMember(familyId)
          && (isOwnerOfMember(familyId, resource.data.granterId) || isOwnerOfMember(familyId, resource.data.granteeId))
          && resource.data.status == 'approved'
          && resource.data.revocable == true
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy']);

        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && resource.data.revocable == false
          && resource.data.relationshipType == 'parent-child'
          && resource.data.status == 'approved'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy']);

        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && resource.data.revocable == false
          && resource.data.relationshipType == 'parent-child'
          && resource.data.status == 'cancelled'
          && request.resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'grantedAt']);

        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && resource.data.relationshipType == 'parent-child'
          && resource.data.revocable == false
          && request.resource.data.revocable == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revocable']);

        allow delete: if false;
      }

      // Owner-Controlled Profile Permission — নতুন collection (amendment item ২)।
      // doc-ID deterministic `{ownerId}_{granteeId}` — accessGrants-এর একই
      // O(1)-lookup pattern। শুধু ownerId নিজেই create/update/delete করতে
      // পারবেন (granteeId কখনো নিজে কিছু লিখতে পারবেন না — one-directional
      // owner-control, কোনো approval/pending-state নেই)।
      match /profileShares/{shareId} {
        allow read: if request.auth != null && isFamilyMember(familyId);

        allow create: if request.auth != null
          && request.resource.data.ownerId == callerMemberIdOf(familyId)
          && isOwnerOfMember(familyId, request.resource.data.ownerId)
          && request.resource.data.ownerId != request.resource.data.granteeId
          && shareId == request.resource.data.ownerId + '_' + request.resource.data.granteeId
          && request.resource.data.keys().hasOnly(['ownerId', 'granteeId', 'read', 'write', 'updatedAt'])
          && request.resource.data.read is bool
          && request.resource.data.write is bool;

        allow update: if request.auth != null
          && resource.data.ownerId == callerMemberIdOf(familyId)
          && isOwnerOfMember(familyId, resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.granteeId == resource.data.granteeId
          && request.resource.data.keys().hasOnly(['ownerId', 'granteeId', 'read', 'write', 'updatedAt'])
          && request.resource.data.read is bool
          && request.resource.data.write is bool;

        allow delete: if request.auth != null
          && resource.data.ownerId == callerMemberIdOf(familyId)
          && isOwnerOfMember(familyId, resource.data.ownerId);
      }

      match /healthRecords/{id} {
        allow read: if request.auth != null
          && hasReadAccess(familyId, resource.data.memberId, callerMemberIdOf(familyId));
        allow create: if request.auth != null
          && request.resource.data.resourceType in
             ['condition', 'observation', 'medicationStatement', 'allergy']
          && hasWriteAccess(familyId, request.resource.data.memberId, request.resource.data.lastEditedByMemberId);
        allow update: if request.auth != null
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.resourceType == resource.data.resourceType
          && hasWriteAccess(familyId, resource.data.memberId, request.resource.data.lastEditedByMemberId);
        allow delete: if request.auth != null && hasDeleteAccess(familyId, resource.data.memberId);
      }

      // Document/Report upload (Roadmap §7, Checklist P2) — owner-decision:
      // Firebase Storage/Cloudflare R2 (card বাধ্যতামূলক) ও Google Drive
      // (no-phone design-principle ভাঙে) দুটোই বাতিল করে Cloudinary ব্যবহার
      // হচ্ছে। এখানে শুধু metadata (memberId, docType, cloudinaryUrl/
      // publicId ইত্যাদি) — আসল ফাইল Cloudinary-তে। Cloudinary API-secret
      // আড়াল রাখতে আলাদা Cloudflare Worker (`worker/`) আছে, যেটা upload/
      // delete-এর আগে ঠিক এই rule-দুটো (read/delete) দিয়েই permission verify
      // করে caller-এর ID token দিয়ে সরাসরি Firestore REST API call করে —
      // অর্থাৎ Worker কোনো permission-logic ডুপ্লিকেট করে না।
      match /documents/{id} {
        allow read: if request.auth != null
          && hasReadAccess(familyId, resource.data.memberId, callerMemberIdOf(familyId));
        allow create: if request.auth != null
          && hasWriteAccess(familyId, request.resource.data.memberId, request.resource.data.lastEditedByMemberId);
        allow update: if request.auth != null
          && request.resource.data.memberId == resource.data.memberId
          && hasWriteAccess(familyId, resource.data.memberId, request.resource.data.lastEditedByMemberId);
        allow delete: if request.auth != null && hasDeleteAccess(familyId, resource.data.memberId);
      }

      match /healthEpisodes/{episodeId} {
        allow read: if request.auth != null
          && hasReadAccess(familyId, resource.data.memberId, callerMemberIdOf(familyId));
        allow create: if request.auth != null
          && hasWriteAccess(familyId, request.resource.data.memberId, request.resource.data.lastEditedByMemberId);
        allow update: if request.auth != null
          && request.resource.data.memberId == resource.data.memberId
          && hasWriteAccess(familyId, resource.data.memberId, request.resource.data.lastEditedByMemberId);
        allow delete: if false;

        match /triageResults/{triageId} {
          allow read: if request.auth != null
            && hasReadAccess(familyId, resource.data.memberId, callerMemberIdOf(familyId));
          allow create: if request.auth != null
            && hasWriteAccess(familyId, request.resource.data.memberId, request.resource.data.lastEditedByMemberId);
          allow update, delete: if false;
        }

        match /messages/{messageId} {
          allow read: if request.auth != null
            && hasReadAccess(familyId,
                 get(/databases/$(database)/documents/families/$(familyId)/healthEpisodes/$(episodeId)).data.memberId,
                 callerMemberIdOf(familyId));
          allow create: if request.auth != null
            && hasWriteAccess(familyId,
                 get(/databases/$(database)/documents/families/$(familyId)/healthEpisodes/$(episodeId)).data.memberId,
                 callerMemberIdOf(familyId));
          allow update, delete: if false;
        }
      }

      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.targetUid;
        allow create: if request.auth != null
          && isFamilyMember(familyId)
          && exists(/databases/$(database)/documents/families/$(familyId)/uidMemberIndex/$(request.resource.data.targetUid))
          && request.resource.data.keys().hasOnly(['targetUid', 'type', 'message', 'read', 'createdAt'])
          && request.resource.data.read == false;
        allow update: if request.auth != null
          && request.auth.uid == resource.data.targetUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if request.auth != null && request.auth.uid == resource.data.targetUid;
      }

      // নতুন (owner-request, ২০২৬-০৯-১২ — item ৪ Vaccination Scheduler + item ৫ Family
      // Health Calendar, দুটোই একই collection শেয়ার করে, eventType discriminator দিয়ে,
      // duplicate-schema/rules এড়াতে): Member Roster-এর মতোই family-wide open-read
      // (isFamilyMember, hasAccess()/memberId-gate না — কারণ event পরিবারের যে কেউ
      // দেখতে/জানতে পারা উচিত, যেমন কার vaccination কবে বা পারিবারিক ডাক্তার-visit)।
      // Write শুধু creator নিজে বা Admin করতে পারবে (notifications-এর uid-gate
      // pattern-এর অনুরূপ, কিন্তু callerMemberIdOf দিয়ে, কারণ delete/edit নিজের
      // family-member-পরিচয়ে হওয়া উচিত uid-এ না)।
      match /healthCalendarEvents/{eventId} {
        allow read: if request.auth != null && isFamilyMember(familyId);
        allow create: if request.auth != null
          && isFamilyMember(familyId)
          && request.resource.data.lastEditedByMemberId == callerMemberIdOf(familyId);
        allow update: if request.auth != null
          && isFamilyMember(familyId)
          && (isAdminOfFamily(familyId) || resource.data.lastEditedByMemberId == callerMemberIdOf(familyId))
          && request.resource.data.lastEditedByMemberId == callerMemberIdOf(familyId);
        allow delete: if request.auth != null
          && isFamilyMember(familyId)
          && (isAdminOfFamily(familyId) || resource.data.lastEditedByMemberId == callerMemberIdOf(familyId));
      }

      // নতুন — Doctor Details & Visiting Card (owner-request, ২০২৬-০৯-১৩)। পুরো
      // পরিবারের জন্য common reference directory, কোনো নির্দিষ্ট member/condition-এর
      // সাথে bound না — তাই healthCalendarEvents-এর হুবহু একই family-wide
      // open-read, creator/Admin-write pattern reuse (Condition.treatingPhysician
      // থেকে ইচ্ছাকৃতভাবে independent collection, কারণ এটা কোনো নির্দিষ্ট
      // Condition-bound না)। Visiting-card ছবি Cloudinary-তে; upload/delete
      // signature Worker দিয়ে verify হয় (documents-এর হুবহু pattern —
      // /doctor-upload-auth ও /doctor-delete endpoint, worker/src/index.js দ্রষ্টব্য)।
      // User-Owned Content model-এ upgrade (owner-approved amendment, item ৩):
      // edit এখন শুধু creator নিজেই করতে পারবেন (আগে Admin-ও পারতেন) — delete
      // creator বা Admin উভয়েই পারবেন (moderation-override, অপরিবর্তিত)।
      match /doctors/{doctorId} {
        allow read: if request.auth != null && isFamilyMember(familyId);
        allow create: if request.auth != null
          && isFamilyMember(familyId)
          && request.resource.data.lastEditedByMemberId == callerMemberIdOf(familyId);
        allow update: if request.auth != null
          && isFamilyMember(familyId)
          && resource.data.lastEditedByMemberId == callerMemberIdOf(familyId)
          && request.resource.data.lastEditedByMemberId == callerMemberIdOf(familyId);
        allow delete: if request.auth != null
          && isFamilyMember(familyId)
          && (isAdminOfFamily(familyId) || resource.data.lastEditedByMemberId == callerMemberIdOf(familyId));
      }
    }
  }
}
